# Postgres connection string. When unset, the app uses an embedded PGlite database in .data/pglite
# (fine for development and demos, not for production).
DATABASE_URL=postgres://user:password@localhost:5432/binaotu

# Secret used to seal session cookies. Required in production: a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
